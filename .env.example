# Postgres connection string (needs the pgvector extension for memory items).
DATABASE_URL=

# Set to 1 to start background work (cron scheduler + Discord gateway + Telegram
# poller) in `next dev` — `npm run dev:full` sets it for you.
SATURN_DEV_BACKGROUND=

# Set to 1 to run Saturn as a single-owner instance: no sign-in, no plans,
# limits, or credits. A synthetic "owner" user is auto-created on first boot
# with the example workflow seeded. THERE IS NO AUTH ON THE DASHBOARD under
# this flag — keep the app bound to localhost.
SELF_HOSTED=

# Static bearer token guarding the MCP server at /mcp under SELF_HOSTED
# (external agents send `Authorization: Bearer <this>`). Unset = /mcp 401s on
# every request. Generate any long random string.
SELF_HOSTED_MCP_TOKEN=
